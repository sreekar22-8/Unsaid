# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/unsaid?sslmode=require"

# Google Gemini API Key for Emotion Detection, Reflection, and Memory Extraction
GEMINI_API_KEY="your-gemini-api-key"

# Supabase Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Frontend Vite Public Keys (prefixed with VITE_)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
